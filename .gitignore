import tkinter as tk
from tkinter import messagebox, ttk
import random
import json
import os

# Базовый набор цитат
DEFAULT_QUOTES = [
    {"text": "Жизнь — это то, что с тобой происходит, пока ты строишь планы.", "author": "Джон Леннон", "category": "Жизнь"},
    {"text": "Логика может привести вас от пункта А к пункту Б, а воображение — куда угодно.", "author": "Альберт Эйнштейн", "category": "Наука"},
    {"text": "Успех — это идти от ошибки к ошибке, не теряя энтузиазма.", "author": "Уинстон Черчилль", "category": "Успех"}
]

class QuoteApp:
    def __init__(self, root):
        self.root = root
        self.root.title("Random Quote Generator")
        self.root.geometry("600x500")
        
        self.history_file = "history.json"
        self.quotes = DEFAULT_QUOTES
        self.history = self.load_history()

        self.setup_ui()

    def setup_ui(self):
        # Секция вывода цитаты
        self.quote_label = tk.Label(self.root, text="Нажмите кнопку, чтобы получить цитату", 
                                   wraplength=500, font=("Arial", 12, "italic"), py=20)
        self.quote_label.pack()

        # Кнопки управления
        btn_frame = tk.Frame(self.root)
        btn_frame.pack(pady=10)
        
        tk.Button(btn_frame, text="Сгенерировать цитату", command=self.generate_quote).pack(side=tk.LEFT, padx=5)
        
        # Фильтрация
        filter_frame = tk.LabelFrame(self.root, text="Фильтрация истории")
        filter_frame.pack(fill="x", padx=10, pady=5)
        
        tk.Label(filter_frame, text="Автор/Тема:").pack(side=tk.LEFT, padx=5)
        self.filter_entry = tk.Entry(filter_frame)
        self.filter_entry.pack(side=tk.LEFT, fill="x", expand=True, padx=5)
        tk.Button(filter_frame, text="Применить", command=self.update_history_display).pack(side=tk.LEFT, padx=5)

        # История (Список)
        self.history_list = tk.Listbox(self.root, width=70)
        self.history_list.pack(pady=10, padx=10, fill="both", expand=True)
        
        self.update_history_display()

    def generate_quote(self):
        quote = random.choice(self.quotes)
        self.quote_label.config(text=f"«{quote['text']}»\n— {quote['author']}")
        
        # Добавление в историю
        self.history.append(quote)
        self.save_history()
        self.update_history_display()

    def update_history_display(self):
        self.history_list.delete(0, tk.END)
        search_query = self.filter_entry.get().lower()
        
        for q in reversed(self.history):
            if search_query in q['author'].lower() or search_query in q['category'].lower():
                self.history_list.insert(tk.END, f"[{q['category']}] {q['author']}: {q['text']}")

    def save_history(self):
        with open(self.history_file, 'w', encoding='utf-8') as f:
            json.dump(self.history, f, ensure_ascii=False, indent=4)

    def load_history(self):
        if os.path.exists(self.history_file):
            try:
                with open(self.history_file, 'r', encoding='utf-8') as f:
                    return json.load(f)
            except: return []
        return []

if __name__ == "__main__":
    root = tk.Tk()
    app = QuoteApp(root)
    root.mainloop()

